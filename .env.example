# Runtime
NODE_ENV=development
APP_ENV=dev

# Logging
LOG_LEVEL=info
LOG_PATH=./logs
LOG_TO_FILE=false
LOG_CHANNEL=abc
LOG_PRODUCT=xyz
SERVICE_TYPE=dummy

# AWS/LocalStack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localstack:4566

# Queues
SQS_QUEUE_NAMES=dummy-dev
SQS_DLQ_SUFFIX=-dlq
# Only honored when NODE_ENV !== production and SQS_ENDPOINT is set
AUTO_CREATE_QUEUES=true

# Consumer tuning
SQS_POLLING_WAIT_SECS=20
SQS_VISIBILITY_TIMEOUT_SECS=60
SQS_BATCH_SIZE=10
CONCURRENCY=10

# HTTP / health
HTTP_TIMEOUT_MS=10000
HEALTHCHECK_PORT=3000

# Temporal
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE_DUMMY_1=dummy-1-task-queue
TEMPORAL_TASK_QUEUE_DUMMY_2=dummy-2-task-queue
TEMPORAL_MAX_ACTIVITY_TASKS=5
TEMPORAL_MAX_WORKFLOW_TASKS=5
TEMPORAL_CONNECTION_TIMEOUT=30000
TEMPORAL_RETRY_ATTEMPTS=3
TEMPORAL_RETRY_DELAY=5000
SPAWN_TEMPORAL_WORKER=true
# Optional TLS
TEMPORAL_TLS_ENABLED=false
# TEMPORAL_TLS_SERVER_NAME=
# TEMPORAL_TLS_CLIENT_CERT=
# TEMPORAL_TLS_CLIENT_KEY=
# TEMPORAL_TLS_CA_CERT=
# Optional when running src/temporal/worker.ts directly
TEMPORAL_WORKER_ROLE=all

# Commercetools
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_PROJECT_KEY=
CTP_SCOPES=
