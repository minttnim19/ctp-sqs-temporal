{
  "name": "ctp-sqs-temporal",
  "version": "1.0.0",
  "type": "commonjs",
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "dev": "npm run build && node --watch dist/main.js | pino-pretty --colorize --translateTime 'SYS:standard' --ignore 'pid,hostname'",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:architecture": "eslint src/application src/domain --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.883.0",
    "@aws-sdk/client-sqs": "^3.883.0",
    "@commercetools/platform-sdk": "^8.16.0",
    "@commercetools/sdk-client-v2": "^3.0.0",
    "@temporalio/client": "^1.17.2",
    "@temporalio/worker": "^1.17.2",
    "@temporalio/workflow": "^1.17.2",
    "axios": "^1.7.7",
    "dotenv": "^17.2.2",
    "pino": "^9.13.1",
    "pino-roll": "^3.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.15.0",
    "@types/aws-lambda": "^8.10.161",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "baseline-browser-mapping": "^2.10.7",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "lint-staged": "^16.1.6",
    "picomatch": "^4.0.3",
    "pino-pretty": "^12.1.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.4.1",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.7.0"
  },
  "overrides": {
    "protobufjs": ">=7.5.6"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
